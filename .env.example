NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-64-plus-char-random-secret
ADMIN_EMAILS=you@example.com
APP_BASE_URL=http://localhost:3080
# Production: APP_BASE_URL=https://tribams.com

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# Local/dev: leave DATABASE_URL empty → SQLite (database/tribams.db)
# Production STANDARD (Cloudflare / public host): hosted Postgres — required
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/tribams?sslmode=require
# DB_CLIENT=postgres
# PGSSL=true
DATABASE_URL=

# SMTP — Gmail App Password recommended
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tribamszetu@gmail.com
EMAIL_PASS=
EMAIL_FROM=TRIBAMS <tribamszetu@gmail.com>

# Windows antivirus TLS inspection (self-signed cert in chain). Set false only if SMTP works cleanly.
EMAIL_TLS_INSECURE=true
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Pricing (NAD)
PRICE_MONTHLY_NAD=450
PRICE_ANNUAL_MONTHLY_NAD=299
PRICE_PRO_PLUS_2MO_NAD=800
PRICE_PRO_PLUS_ANNUAL_MONTHLY_NAD=350
# Special Ops Elite (above Pro+) — modules 96–97
PRICE_SPECIAL_OPS_2MO_NAD=1250
PRICE_SPECIAL_OPS_ANNUAL_MONTHLY_NAD=520
NAD_PER_USD=18.5
FREE_MODULE_IDS=1,7,37
PRO_MAX_MODULE_ID=95

# ------------------------------------------------------------
# Cloudflare / production hosting notes
# ------------------------------------------------------------
# Tribams needs a Node.js origin (VPS, Railway, Fly, Render, or CF Containers).
# Put tribams.com on Cloudflare DNS (proxied) in front of that origin.
# Do NOT expect Workers-only deploy without a major rewrite (sqlite3/bcrypt/PDF/filesystem).
# Cloudflare: SSL Full (strict), Always HTTPS, bypass cache for /api/* and member pages.
# APP_BASE_URL must be https://tribams.com when live.
# Production DB = hosted Postgres via DATABASE_URL (above) — not SQLite.
SESSION_STORE=memory
TRUST_PROXY=1
# See docs/CLOUDFLARE_HOSTING.md — mechanical checklist for your accounts.

# B2B licensing (NAD annual packs)
PRICE_LICENSE_INSTITUTION_NAD=18000
PRICE_LICENSE_ENTERPRISE_NAD=45000
PRICE_LICENSE_SME_NAD=6500
PRICE_CUSTOM_TRAINING_NAD=12000

# PayPal (required for public paid upgrades)
# Sandbox: https://developer.paypal.com/dashboard/ → Apps → Sandbox
# Live: set PAYPAL_MODE=live and use Live credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD

OPENAI_API_KEY=
