# Copy to .env before `npm start` or Railway deploy.
# Railway: set variables on the web service (not Postgres). No repo .env file in the container.
# Required on Railway: NODE_ENV=production, SESSION_SECRET (64+ chars), DATABASE_URL, APP_BASE_URL
# Railway injects PORT. The app binds 0.0.0.0 and reads process.env.PORT.
# Production: NODE_ENV=production, DATABASE_URL=postgres://..., APP_BASE_URL=https://your-host
# Do not set DEMO_SQLITE_FALLBACK=true on Railway — redeploys wipe the SQLite file.

NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-64-plus-char-random-secret
# Operator console (/admin): Katva only — email match, never usernames.
ADMIN_EMAILS=kativabritish@gmail.com
APP_BASE_URL=http://localhost:3080
# Production: APP_BASE_URL=https://tribams.com

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# Laptop demo: SESSION_STORE=file so logins survive node restarts
# SESSION_STORE=file
# Local/dev: leave DATABASE_URL empty → SQLite (database/tribams.db)
# Supabase on Railway — Session pooler port 5432 (6543 often times out):
# DATABASE_URL=postgresql://postgres.YOUR_REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
# PGSSL and PGSSL_SERVERNAME auto-detect for *.supabase.com hosts when DATABASE_URL is set.
# DB_CLIENT=postgres
DATABASE_URL=

# SMTP — Gmail App Password recommended
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tribamszetu@gmail.com
EMAIL_PASS=
EMAIL_FROM=TRIBAMS <tribamszetu@gmail.com>

# Windows antivirus TLS inspection (self-signed cert in chain). Set false only if SMTP works cleanly.
EMAIL_TLS_INSECURE=true
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Pricing — USD is list + PayPal checkout (PAYPAL_CURRENCY=USD).
# NAD vars are optional Namibia reference: used only when the matching PRICE_*_USD is unset
# (converted via NAD_PER_USD). Do not treat NAD as the checkout currency.
PRICE_MONTHLY_USD=24
PRICE_ANNUAL_MONTHLY_USD=16
PRICE_PRO_PLUS_2MO_USD=45
PRICE_PRO_PLUS_ANNUAL_MONTHLY_USD=19
# Special Ops Elite (above Pro+) — modules 96–97
PRICE_SPECIAL_OPS_2MO_USD=68
PRICE_SPECIAL_OPS_ANNUAL_MONTHLY_USD=29
# Optional NAD overrides/reference (ignored when the matching *_USD is set)
# PRICE_MONTHLY_NAD=450
# PRICE_ANNUAL_MONTHLY_NAD=299
# PRICE_PRO_PLUS_2MO_NAD=800
# PRICE_PRO_PLUS_ANNUAL_MONTHLY_NAD=350
# PRICE_SPECIAL_OPS_2MO_NAD=1250
# PRICE_SPECIAL_OPS_ANNUAL_MONTHLY_NAD=520
NAD_PER_USD=18.5
FREE_MODULE_IDS=1,7,37
PRO_MAX_MODULE_ID=95

# ------------------------------------------------------------
# Cloudflare / production hosting notes
# ------------------------------------------------------------
# Tribams needs a Node.js origin (VPS, Railway, Fly, Render, or CF Containers).
# Put tribams.com on Cloudflare DNS (proxied) in front of that origin.
# Do NOT expect Workers-only deploy without a major rewrite (sqlite3/bcrypt/PDF/filesystem).
# Cloudflare: SSL Full (strict), Always HTTPS, bypass cache for /api/* and member pages.
# APP_BASE_URL must be https://tribams.com when live.
# Production DB = hosted Postgres via DATABASE_URL (above) — not SQLite.
SESSION_STORE=memory
TRUST_PROXY=1
# See docs/CLOUDFLARE_HOSTING.md — mechanical checklist for your accounts.

# B2B licensing (USD annual packs; NAD optional if the matching *_USD is unset)
PRICE_LICENSE_SME_USD=350
PRICE_LICENSE_INSTITUTION_USD=990
PRICE_LICENSE_ENTERPRISE_USD=2490
PRICE_CUSTOM_TRAINING_USD=650
# PRICE_LICENSE_SME_NAD=6500
# PRICE_LICENSE_INSTITUTION_NAD=18000
# PRICE_LICENSE_ENTERPRISE_NAD=45000
# PRICE_CUSTOM_TRAINING_NAD=12000

# PayPal (live card checkout). If empty, /payment still accepts plan requests and license keys.
# Sandbox: https://developer.paypal.com/dashboard/ → Apps → Sandbox
# Live: set PAYPAL_MODE=live and use Live credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD

OPENAI_API_KEY=

# ------------------------------------------------------------
# Personal data (see /privacy and docs/PRIVACY.md)
# ------------------------------------------------------------
# This app stores accounts, training scores, PayPal order refs, org licenses,
# contact/sales leads, and a tribams.sid session cookie. It does not set
# advertising cookies. Namibia is home law; processors (PayPal, SMTP, host)
# may sit abroad. Do not paste production dumps into tickets.
