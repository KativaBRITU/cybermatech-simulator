{
    "env": {
        "node": true,
        "browser": true,
        "es2021": true
    },
    "extends": [
        "eslint:recommended"
    ],
    "plugins": ["security"],
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "rules": {
        "security/detect-object-injection": "warn",
        "security/detect-non-literal-fs-filename": "warn",
        "security/detect-child-process": "warn",
        "no-console": "off",
        "no-unused-vars": "warn",
        "no-undef": "error"
    },
    "ignorePatterns": [
        "node_modules/",
        "database/",
        "public/",
        "*.log"
    ]
}
